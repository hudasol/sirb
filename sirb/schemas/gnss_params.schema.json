{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sirb/schemas/gnss_params.schema.json",
  "title": "Sirb GNSS degradation model parameters",
  "description": "Version 1. Strict: no unknown keys, provenance and per-parameter assumed flags are mandatory. Semantic rules not expressible here (ISO date validity, unique region names, end_s > start_s, bbox ordering) are enforced by sirb.gnss_params.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "model",
    "provenance",
    "parameters"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "model": {
      "const": "sirb-gnss-gauss-markov"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_name",
        "url",
        "licence",
        "retrieval_date",
        "derived_by"
      ],
      "properties": {
        "source_name": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "licence": {
          "type": "string",
          "minLength": 1
        },
        "derived_by": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string",
          "minLength": 1
        },
        "retrieval_date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "white_sigma",
        "degraded_fraction",
        "bias_sigma",
        "bias_tau",
        "dropout_fraction",
        "dropout_duration",
        "dead_reckoning_rate"
      ],
      "properties": {
        "white_sigma": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "unit",
            "assumed"
          ],
          "properties": {
            "value": {
              "type": "number",
              "minimum": 0
            },
            "unit": {
              "const": "m"
            },
            "assumed": {
              "type": "boolean"
            }
          }
        },
        "degraded_fraction": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "unit",
            "assumed"
          ],
          "properties": {
            "value": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "unit": {
              "const": "1"
            },
            "assumed": {
              "type": "boolean"
            }
          }
        },
        "bias_sigma": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "unit",
            "assumed"
          ],
          "properties": {
            "value": {
              "type": "number",
              "minimum": 0
            },
            "unit": {
              "const": "m"
            },
            "assumed": {
              "type": "boolean"
            }
          }
        },
        "bias_tau": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "unit",
            "assumed"
          ],
          "properties": {
            "value": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "unit": {
              "const": "s"
            },
            "assumed": {
              "type": "boolean"
            }
          }
        },
        "dropout_fraction": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "unit",
            "assumed"
          ],
          "properties": {
            "value": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "unit": {
              "const": "1"
            },
            "assumed": {
              "type": "boolean"
            }
          }
        },
        "dropout_duration": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "unit",
            "assumed"
          ],
          "properties": {
            "value": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "unit": {
              "const": "s"
            },
            "assumed": {
              "type": "boolean"
            }
          }
        },
        "dead_reckoning_rate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "unit",
            "assumed"
          ],
          "properties": {
            "value": {
              "type": "number",
              "minimum": 0
            },
            "unit": {
              "const": "m/sqrt(s)"
            },
            "assumed": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "spatial": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "region_scale_factors"
      ],
      "properties": {
        "region_scale_factors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "scale",
              "assumed"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "scale": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "bbox_xy_m": {
                "type": "array",
                "minItems": 4,
                "maxItems": 4,
                "items": {
                  "type": "number"
                }
              },
              "assumed": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "temporal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "window"
      ],
      "properties": {
        "window": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "start_s",
            "end_s",
            "assumed"
          ],
          "properties": {
            "start_s": {
              "type": "number",
              "minimum": 0
            },
            "end_s": {
              "type": "number"
            },
            "assumed": {
              "type": "boolean"
            }
          }
        }
      }
    }
  }
}
